{
  "name": "gwei-fm",
  "version": "0.1.0",
  "description": "A stretch of Ethereum, as a piece of music. One block per beat, chords from the fee market, drums from the traffic.",
  "type": "module",
  "bin": {
    "gwei-fm": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "ethereum",
    "sonification",
    "generative-music",
    "audio",
    "wav",
    "blockchain",
    "art",
    "synthesizer",
    "creative-coding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
